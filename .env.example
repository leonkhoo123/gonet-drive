# GoNet Drive - example environment file.
#
# Copy to `.env` in the repo root and edit as needed:
#     cp .env.example .env
#
# Every value below has a built-in default, so an empty or absent file is fine
# for local development. The server loads `../.env` first, then `.env`, relative
# to its working directory (the Makefile runs from `backend/`, so the repo-root
# `.env` is picked up).
#
# Note: APP_JWTSECRET is no longer used - the JWT signing secret is generated and
# rotated automatically by the auth library. The first admin user is created via
# the web setup flow, not via environment variables.

# ---------------------------------------------------------------- server ----
APP_ENV=local                  # local | prod ; use prod in production
LISTEN_ADDR=:8080              # host:port the server binds to
WORK_DIR=/app/data             # root folder served/managed (local dev: e.g. ./data)
DB_DIR=                        # SQLite dir; empty uses the default; Docker uses /app/db
VIDEO_HOSTNAME=                # optional public base URL override used in media links
VIDEO_MODE=custom              # normal | custom ; "custom" enables the V2 video player
LOG_LEVEL=info                 # debug | info | warn | error

# ------------------------------------------------------ security / CORS -----
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; "*" and "null" are rejected
TRUSTED_PROXY_CIDRS=                    # comma-separated proxy CIDRs for X-Forwarded-For
APP_JWT=                                # set to OFF to disable auth (non-prod only)
ALLOW_UNSAFE_UNPROTECTED_MODE=          # true (non-prod only) to permit APP_JWT=OFF
SECURE_MODE=                            # optional; defaults to APP_ENV == "production"

# ------------------------------------------------------------- thumbnails ---
THUMBNAIL_MAX_CONCURRENT=1
THUMBNAIL_GENERATION_TIMEOUT=30s

# ---------------------------------------------------------------- defaults --
DEFAULT_SERVICE_NAME=GoNet Drive
DEFAULT_UPLOAD_CHUNK_SIZE=5     # MB
DEFAULT_STORAGE_LIMIT=20480     # MB
